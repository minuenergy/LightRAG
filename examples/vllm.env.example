###############################################################################
# LightRAG with vLLM Configuration
###############################################################################
# 이 파일을 .env로 복사하여 사용하세요:
# cp examples/vllm.env.example .env
#
# vLLM 서버를 먼저 실행해야 합니다:
# 1. vllm serve openai/gpt-oss-20b --port 8000 --tensor-parallel-size 4 \
#       --gpu-memory-utilization 0.30 --max-model-len 8192
# 2. vllm serve BAAI/bge-m3 --port 8001 --gpu-memory-utilization 0.1
###############################################################################

###########################
### Server Configuration
###########################
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE='LightRAG with vLLM'
WEBUI_DESCRIPTION="Graph-based RAG powered by vLLM"
# WORKERS=2
TIMEOUT=180

###########################
### Directory Configuration
###########################
WORKING_DIR=./vllm_rag_storage
# INPUT_DIR=./inputs

###########################
### Logging Configuration
###########################
LOG_LEVEL=INFO
VERBOSE=False
# LOG_DIR=/path/to/log/directory

###############################################################################
### LLM Configuration (vLLM)
###############################################################################
LLM_BINDING=openai
LLM_MODEL=openai/gpt-oss-20b
LLM_BINDING_HOST=http://localhost:8000/v1
LLM_BINDING_API_KEY=EMPTY

### LLM request timeout
LLM_TIMEOUT=180

### OpenAI Compatible API Parameters
OPENAI_LLM_TEMPERATURE=0.7
OPENAI_LLM_MAX_TOKENS=4096

### Qwen3 등 특정 모델에서 무한 루프 방지를 위해 temperature를 높일 수 있습니다
# OPENAI_LLM_TEMPERATURE=0.9

### vLLM의 특정 기능을 사용하려면 extra_body 설정
# OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'

###############################################################################
### Embedding Configuration (vLLM)
###############################################################################
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BINDING_HOST=http://localhost:8001/v1
EMBEDDING_BINDING_API_KEY=EMPTY
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_SEND_DIM=false
EMBEDDING_TIMEOUT=30

###############################################################################
### Query Configuration
###############################################################################
### LLM 응답 캐시 활성화 (쿼리용)
ENABLE_LLM_CACHE=true

### Knowledge Graph에서 검색할 엔티티/관계 수
TOP_K=40

### Naive 벡터 검색에서 가져올 최대 청크 수
CHUNK_TOP_K=20

### LLM에 전송할 실제 엔티티 토큰 제어
MAX_ENTITY_TOKENS=6000

### LLM에 전송할 실제 관계 토큰 제어
MAX_RELATION_TOKENS=8000

### LLM에 전송할 최대 토큰 (엔티티, 관계, 청크 포함)
MAX_TOTAL_TOKENS=30000

### 코사인 유사도 임계값
COSINE_THRESHOLD=0.2

### 청크 선택 전략: VECTOR (벡터 유사도) 또는 WEIGHT (엔티티/청크 가중치)
KG_CHUNK_PICK_METHOD=VECTOR

### 소스당 관련 청크 수
RELATED_CHUNK_NUMBER=5

###############################################################################
### Reranking Configuration
### vLLM으로 배포된 reranker 모델을 사용할 경우 cohere 바인딩 사용
###############################################################################
RERANK_BINDING=null
# RERANK_BY_DEFAULT=True
# MIN_RERANK_SCORE=0.0

### vLLM으로 로컬 배포된 Reranker 사용 예시
# RERANK_BINDING=cohere
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_BINDING_HOST=http://localhost:8002/v1/rerank
# RERANK_BINDING_API_KEY=EMPTY

###############################################################################
### Document Processing Configuration
###############################################################################
### 문서 처리 시 LLM 캐시 활성화
ENABLE_LLM_CACHE_FOR_EXTRACT=true

### 문서 처리 출력 언어
SUMMARY_LANGUAGE=Korean

### LLM이 인식할 엔티티 타입
ENTITY_TYPES='["Person", "Organization", "Location", "Event", "Concept", "Method", "Technology", "Product"]'

### 청크 크기 (500~1500 권장)
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100

### 엔티티/관계 병합 시 LLM 요약을 트리거할 세그먼트 수
FORCE_LLM_SUMMARY_ON_MERGE=8
SUMMARY_MAX_TOKENS=1200
SUMMARY_LENGTH_RECOMMENDED=600
SUMMARY_CONTEXT_SIZE=12000

### 벡터 및 그래프 DB에 저장할 최대 chunk_id 수
MAX_SOURCE_IDS_PER_ENTITY=300
MAX_SOURCE_IDS_PER_RELATION=300

### chunk_id 제한 방법: FIFO (먼저 들어온 것 먼저 제거) 또는 KEEP (가장 오래된 것 유지)
SOURCE_IDS_LIMIT_METHOD=FIFO

### 엔티티/관계 file_path 필드에 저장할 최대 파일 경로 수
MAX_FILE_PATHS=100

###############################################################################
### Concurrency Configuration
###############################################################################
### LLM의 최대 동시 요청 수 (쿼리 및 문서 처리 모두)
MAX_ASYNC=4

### 병렬 처리할 문서 수 (2~10, MAX_ASYNC/3 권장)
MAX_PARALLEL_INSERT=2

### Embedding의 최대 동시 요청 수
EMBEDDING_FUNC_MAX_ASYNC=8

### 단일 Embedding 요청에 포함할 청크 수
EMBEDDING_BATCH_NUM=10

###############################################################################
### Storage Configuration
###############################################################################
### 기본 스토리지 (소규모 배포에 권장)
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

### 프로덕션 배포에는 아래 스토리지 사용 권장:

### PostgreSQL (All-in-One)
# LIGHTRAG_KV_STORAGE=PGKVStorage
# LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
# LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
# LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=your_username
# POSTGRES_PASSWORD=your_password
# POSTGRES_DATABASE=lightrag
# POSTGRES_MAX_CONNECTIONS=12

### Neo4j (Graph Storage)
# LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
# NEO4J_URI=neo4j://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your_password
# NEO4J_DATABASE=neo4j

### Milvus (Vector Storage)
# LIGHTRAG_VECTOR_STORAGE=MilvusVectorDBStorage
# MILVUS_URI=http://localhost:19530
# MILVUS_DB_NAME=lightrag

### MongoDB (All-in-One)
# LIGHTRAG_KV_STORAGE=MongoKVStorage
# LIGHTRAG_DOC_STATUS_STORAGE=MongoDocStatusStorage
# LIGHTRAG_GRAPH_STORAGE=MongoGraphStorage
# LIGHTRAG_VECTOR_STORAGE=MongoVectorDBStorage
# MONGO_URI=mongodb://localhost:27017/
# MONGO_DATABASE=LightRAG

### Redis (KV Storage)
# LIGHTRAG_KV_STORAGE=RedisKVStorage
# LIGHTRAG_DOC_STATUS_STORAGE=RedisDocStatusStorage
# REDIS_URI=redis://localhost:6379

###############################################################################
### Workspace Isolation
###############################################################################
### 워크스페이스 이름 (데이터 격리용)
# WORKSPACE=vllm_workspace

###############################################################################
### Authentication (Optional)
###############################################################################
# AUTH_ACCOUNTS='admin:admin123,user1:pass456'
# TOKEN_SECRET=Your-Secret-Key-For-JWT
# TOKEN_EXPIRE_HOURS=48

### API Key 인증
# LIGHTRAG_API_KEY=your-secure-api-key-here
# WHITELIST_PATHS=/health,/api/*

###############################################################################
### Evaluation Configuration (Optional)
###############################################################################
### RAGAS 평가를 위한 LLM (OpenAI 호환 필요)
# EVAL_LLM_MODEL=gpt-4o-mini
# EVAL_LLM_BINDING_API_KEY=your_api_key
# EVAL_LLM_BINDING_HOST=https://api.openai.com/v1

### RAGAS 평가를 위한 Embedding
# EVAL_EMBEDDING_MODEL=text-embedding-3-large
# EVAL_EMBEDDING_BINDING_API_KEY=your_embedding_api_key
# EVAL_EMBEDDING_BINDING_HOST=https://api.openai.com/v1

### 평가 성능 튜닝
# EVAL_MAX_CONCURRENT=2
# EVAL_QUERY_TOP_K=10
# EVAL_LLM_MAX_RETRIES=5
# EVAL_LLM_TIMEOUT=180

###############################################################################
### Langfuse Observability (Optional)
###############################################################################
# LANGFUSE_SECRET_KEY=""
# LANGFUSE_PUBLIC_KEY=""
# LANGFUSE_HOST="https://cloud.langfuse.com"
# LANGFUSE_ENABLE_TRACE=true
